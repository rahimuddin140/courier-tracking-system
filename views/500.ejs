<div class="container my-5 text-center">
  <div class="py-5">
    <div class="display-1 fw-bold text-danger mb-2">500</div>
    <h2 class="fw-bold mb-3">Server Error</h2>
    <p class="lead text-muted mb-4 mx-auto" style="max-width: 500px;">
      An unexpected internal error occurred while processing your request.
    </p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger d-inline-block text-start small mb-4">
        <code><%= error %></code>
      </div>
    <% } %>
    <div>
      <a href="/" class="btn btn-primary fw-semibold px-4">
        <i class="bi bi-house me-1"></i> Return Home
      </a>
    </div>
  </div>
</div>
