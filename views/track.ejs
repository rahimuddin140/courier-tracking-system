<div class="container my-4">
  <!-- Search Bar Header -->
  <div class="row justify-content-center mb-4">
    <div class="col-lg-8">
      <div class="card p-4 shadow-sm">
        <h4 class="fw-bold mb-3 text-center"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Track Any Parcel</h4>
        <form action="/track" method="POST" class="d-flex gap-2">
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input 
              type="text" 
              name="trackingId" 
              class="form-control" 
              placeholder="Enter Tracking ID (e.g. PKG-20260920-A101)" 
              value="<%= typeof searchedId !== 'undefined' ? searchedId : '' %>" 
              required
            >
          </div>
          <button type="submit" class="btn btn-primary px-4 fw-semibold text-nowrap">
            Search
          </button>
        </form>
      </div>
    </div>
  </div>

  <% if (notFound) { %>
    <!-- Not Found State -->
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="alert alert-warning p-4 rounded-4 shadow-sm text-center">
          <i class="bi bi-exclamation-triangle-fill text-warning fs-1 d-block mb-2"></i>
          <h5 class="fw-bold">No Parcel Found</h5>
          <p class="text-muted mb-3">
            We could not find any shipment registered with tracking ID <strong><%= searchedId %></strong>. Please verify the code and try again.
          </p>
          <div class="small text-muted">
            Try searching for sample IDs: <a href="/track?trackingId=PKG-20260920-A101" class="text-primary fw-semibold">PKG-20260920-A101</a>, <a href="/track?trackingId=PKG-20260920-B202" class="text-primary fw-semibold">PKG-20260920-B202</a>, or <a href="/track?trackingId=PKG-20260921-C303" class="text-primary fw-semibold">PKG-20260921-C303</a>.
          </div>
        </div>
      </div>
    </div>
  <% } else if (parcel) { %>
    <!-- Parcel Details & Tracking Stepper -->
    <%
      const stages = ['Booked', 'Picked Up', 'In Transit', 'Out for Delivery', 'Delivered'];
      const statusOrder = {
        'Booked': 0,
        'Picked Up': 1,
        'In Transit': 2,
        'Out for Delivery': 3,
        'Delivered': 4,
        'Failed': 3, // Failed occurred at delivery stage
        'Cancelled': 0
      };
      const currentIndex = statusOrder[parcel.currentStatus] !== undefined ? statusOrder[parcel.currentStatus] : 0;
    %>

    <div class="row justify-content-center">
      <div class="col-lg-10">
        <!-- Main Shipment Card -->
        <div class="card mb-4 overflow-hidden">
          <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
              <span class="text-muted small text-uppercase fw-semibold">Tracking Number:</span>
              <h4 class="mb-0 fw-bold d-inline-block ms-2 text-primary"><%= parcel.trackingId %></h4>
              <button 
                class="btn btn-outline-primary btn-sm ms-2 btn-copy-tracking py-0 px-2" 
                data-tracking-id="<%= parcel.trackingId %>"
                title="Copy Tracking ID"
              >
                <i class="bi bi-clipboard"></i> Copy
              </button>
            </div>
            <div>
              <%- include('partials/statusBadge', { status: parcel.currentStatus }) %>
            </div>
          </div>

          <div class="card-body p-4">
            <!-- Stepper Progress UI -->
            <% if (parcel.currentStatus === 'Cancelled') { %>
              <div class="alert alert-dark text-center my-3">
                <i class="bi bi-slash-circle-fill me-2 fs-5"></i>
                <strong>This parcel was cancelled</strong> on <%= new Date(parcel.bookedAt).toLocaleDateString() %>.
              </div>
            <% } else { %>
              <div class="tracking-stepper">
                <!-- Step 1: Booked -->
                <div class="step-item <%= currentIndex > 0 ? 'completed' : (currentIndex === 0 ? 'active' : '') %>">
                  <div class="step-icon"><i class="bi bi-file-earmark-check"></i></div>
                  <div class="step-title">Booked</div>
                </div>

                <!-- Step 2: Picked Up -->
                <div class="step-item <%= currentIndex > 1 ? 'completed' : (currentIndex === 1 ? 'active' : '') %>">
                  <div class="step-icon"><i class="bi bi-box-seam"></i></div>
                  <div class="step-title">Picked Up</div>
                </div>

                <!-- Step 3: In Transit -->
                <div class="step-item <%= currentIndex > 2 ? 'completed' : (currentIndex === 2 ? 'active' : '') %>">
                  <div class="step-icon"><i class="bi bi-truck"></i></div>
                  <div class="step-title">In Transit</div>
                </div>

                <!-- Step 4: Out for Delivery -->
                <div class="step-item <%= currentIndex > 3 ? 'completed' : (currentIndex === 3 ? (parcel.currentStatus === 'Failed' ? 'failed' : 'active') : '') %>">
                  <div class="step-icon">
                    <i class="bi <%= parcel.currentStatus === 'Failed' ? 'bi-exclamation-octagon' : 'bi-bicycle' %>"></i>
                  </div>
                  <div class="step-title"><%= parcel.currentStatus === 'Failed' ? 'Delivery Attempt Failed' : 'Out for Delivery' %></div>
                </div>

                <!-- Step 5: Delivered -->
                <div class="step-item <%= currentIndex === 4 ? 'completed' : '' %>">
                  <div class="step-icon"><i class="bi bi-check-circle"></i></div>
                  <div class="step-title">Delivered</div>
                </div>
              </div>
            <% } %>

            <hr class="my-4">

            <!-- Route and Package Information Grid -->
            <div class="row g-4">
              <!-- Sender Info -->
              <div class="col-md-6 col-lg-4">
                <div class="p-3 bg-light rounded-3 h-100">
                  <div class="text-uppercase text-muted fw-bold small mb-2"><i class="bi bi-geo-alt me-1 text-danger"></i> Pickup Address</div>
                  <div class="fw-bold"><%= parcel.senderName %></div>
                  <div class="text-muted small"><%= parcel.senderAddress %></div>
                  <div class="small mt-1"><strong>PIN:</strong> <%= parcel.senderPincode %></div>
                  <div class="small text-muted"><i class="bi bi-telephone me-1"></i><%= parcel.senderPhone %></div>
                </div>
              </div>

              <!-- Receiver Info -->
              <div class="col-md-6 col-lg-4">
                <div class="p-3 bg-light rounded-3 h-100">
                  <div class="text-uppercase text-muted fw-bold small mb-2"><i class="bi bi-geo-fill me-1 text-success"></i> Delivery Address</div>
                  <div class="fw-bold"><%= parcel.receiverName %></div>
                  <div class="text-muted small"><%= parcel.receiverAddress %></div>
                  <div class="small mt-1"><strong>PIN:</strong> <%= parcel.receiverPincode %></div>
                  <div class="small text-muted"><i class="bi bi-telephone me-1"></i><%= parcel.receiverPhone %></div>
                </div>
              </div>

              <!-- Package Specs -->
              <div class="col-md-12 col-lg-4">
                <div class="p-3 bg-light rounded-3 h-100">
                  <div class="text-uppercase text-muted fw-bold small mb-2"><i class="bi bi-box me-1 text-primary"></i> Parcel Details</div>
                  <div class="d-flex justify-content-between small py-1 border-bottom">
                    <span class="text-muted">Type:</span>
                    <span class="fw-semibold"><%= parcel.parcelType %></span>
                  </div>
                  <div class="d-flex justify-content-between small py-1 border-bottom">
                    <span class="text-muted">Weight:</span>
                    <span class="fw-semibold"><%= parcel.weight %> kg</span>
                  </div>
                  <div class="d-flex justify-content-between small py-1 border-bottom">
                    <span class="text-muted">Delivery Charge:</span>
                    <span class="fw-bold text-success">₹<%= parcel.deliveryCharge %></span>
                  </div>
                  <div class="d-flex justify-content-between small py-1">
                    <span class="text-muted">Assigned Agent:</span>
                    <span class="fw-semibold"><%= parcel.assignedAgent ? parcel.assignedAgent.name : 'Pending Assignment' %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Status History Log (Audit Trail) -->
        <div class="card shadow-sm">
          <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Status History Log</h5>
            <small class="text-muted">Immutable timestamped audit log of all updates to this shipment</small>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th>Status</th>
                    <th>Date & Time</th>
                    <th>Updated By</th>
                    <th>Remarks</th>
                  </tr>
                </thead>
                <tbody>
                  <% 
                    // Render status history sorted newest first
                    const sortedHistory = [...parcel.statusHistory].reverse();
                    sortedHistory.forEach(log => { 
                  %>
                    <tr>
                      <td>
                        <%- include('partials/statusBadge', { status: log.status }) %>
                      </td>
                      <td class="text-nowrap small">
                        <i class="bi bi-calendar3 me-1 text-muted"></i>
                        <%= new Date(log.timestamp).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                        <br>
                        <i class="bi bi-clock me-1 text-muted"></i>
                        <%= new Date(log.timestamp).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                      </td>
                      <td class="small">
                        <% if (log.updatedBy) { %>
                          <strong><%= log.updatedBy.name %></strong>
                          <span class="badge bg-light text-dark border ms-1 text-capitalize"><%= log.updatedBy.role %></span>
                        <% } else { %>
                          <span class="text-muted">System</span>
                        <% } %>
                      </td>
                      <td class="small text-muted">
                        <%= log.remarks || 'Status updated.' %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } else { %>
    <!-- Initial Prompt State if no query given -->
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center text-muted py-5">
        <i class="bi bi-qr-code-scan fs-1 d-block mb-3 text-secondary"></i>
        <h5>Enter your Tracking ID to view the live shipment status and full history log.</h5>
      </div>
    </div>
  <% } %>
</div>
