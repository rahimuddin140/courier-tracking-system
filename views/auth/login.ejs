<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="card p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-2" style="width: 50px; height: 50px;">
            <i class="bi bi-box-arrow-in-right fs-3"></i>
          </div>
          <h3 class="fw-bold">Sign In</h3>
          <p class="text-muted small">Log in with your registered account (Customer, Agent, or Admin)</p>
        </div>

        <form action="/login" method="POST">
          <div class="mb-3">
            <label for="email" class="form-label fw-semibold">Email Address</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-envelope"></i></span>
              <input type="email" class="form-control" id="email" name="email" placeholder="name@domain.com" required>
            </div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label fw-semibold">Password</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-key"></i></span>
              <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
            <i class="bi bi-box-arrow-in-right me-1"></i> Log In
          </button>

          <div class="text-center text-muted small mb-4">
            New customer? <a href="/register" class="text-primary fw-semibold text-decoration-none">Create an account</a>
          </div>

          <!-- Quick Fill Demo Login Pills -->
          <div class="border-top pt-3">
            <div class="text-muted small mb-2 text-center"><strong>Demo Quick Fill:</strong></div>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
              <button type="button" class="btn btn-outline-secondary btn-sm" onclick="quickFill('admin@courier.com', 'admin123')">
                <i class="bi bi-shield-lock me-1"></i> Admin
              </button>
              <button type="button" class="btn btn-outline-secondary btn-sm" onclick="quickFill('rajesh@courier.com', 'agent123')">
                <i class="bi bi-truck me-1"></i> Agent
              </button>
              <button type="button" class="btn btn-outline-secondary btn-sm" onclick="quickFill('customer@courier.com', 'customer123')">
                <i class="bi bi-person me-1"></i> Customer
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function quickFill(email, pwd) {
  document.getElementById('email').value = email;
  document.getElementById('password').value = pwd;
}
</script>
