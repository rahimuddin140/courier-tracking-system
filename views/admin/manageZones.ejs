<div class="container my-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <h2 class="fw-bold mb-1">Delivery Zones & Pricing</h2>
      <p class="text-muted mb-0">Configure regional dispatch hubs, covered pincodes, and dynamic rate calculation rules.</p>
    </div>
    <a href="/admin/zones/create" class="btn btn-primary fw-semibold">
      <i class="bi bi-geo-alt-fill me-1"></i> Add Delivery Zone
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <% if (zones && zones.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Zone Name</th>
                <th>Covered Pincodes</th>
                <th>Base Fee</th>
                <th>Rate / kg</th>
                <th>Formula Preview (2 kg pkg)</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% zones.forEach(z => { %>
                <tr>
                  <td>
                    <div class="fw-bold text-primary"><%= z.zoneName %></div>
                    <div class="small text-muted">Created: <%= new Date(z.createdAt).toLocaleDateString() %></div>
                  </td>
                  <td>
                    <div class="d-flex flex-wrap gap-1" style="max-width: 320px;">
                      <% if (z.pincodes && z.pincodes.length > 0) { %>
                        <% z.pincodes.forEach(pin => { %>
                          <span class="badge bg-light text-dark border"><%= pin %></span>
                        <% }) %>
                      <% } else { %>
                        <span class="text-muted small">No specific pincodes</span>
                      <% } %>
                    </div>
                  </td>
                  <td class="fw-semibold text-dark">₹<%= z.baseFee %></td>
                  <td class="fw-semibold text-dark">₹<%= z.perKgRate %>/kg</td>
                  <td class="small">
                    <span class="text-success fw-bold">₹<%= z.baseFee + 2 * z.perKgRate %></span>
                    <span class="text-muted">(₹<%= z.baseFee %> + 2×₹<%= z.perKgRate %>)</span>
                  </td>
                  <td>
                    <a href="/admin/zones/edit/<%= z._id %>" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-pencil"></i> Edit
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-geo fs-1 d-block mb-2 text-secondary"></i>
          <h5>No delivery zones configured</h5>
          <p class="small mb-3">Add regional delivery zones to enable dynamic shipping charge calculations.</p>
          <a href="/admin/zones/create" class="btn btn-primary btn-sm">Create First Zone</a>
        </div>
      <% } %>
    </div>
  </div>
</div>
